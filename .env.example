# ── Site ───────────────────────────────────────────────────────────
# Defaults to https://craftandcode.tech; override only for previews or another domain.
NEXT_PUBLIC_SITE_URL=

# ── Pricing (defaults in src/data/product.ts: ₹599 launch, ₹999 regular) ──
# Leave blank to use the defaults. The regular price must be a genuine price (see docs/LAUNCH_CHECKLIST.md).
NEXT_PUBLIC_PRICE_INR=
NEXT_PUBLIC_COMPARE_AT_INR=
# e.g. "Inclusive of all taxes" — only once confirmed with your CA.
NEXT_PUBLIC_PRICE_NOTE_INR=
# USD stays off until a USD price is decided.
NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_COMPARE_AT_USD=
NEXT_PUBLIC_PRICE_NOTE_USD=

# ── Hosted checkout (Razorpay Payment Page / Payment Link) ──
# Buy buttons go live only when this is set. The amount charged there MUST equal NEXT_PUBLIC_PRICE_INR (599).
NEXT_PUBLIC_CHECKOUT_URL_INR=
NEXT_PUBLIC_CHECKOUT_URL_USD=
# Set to "true" only after verified-payment delivery is implemented AND tested end to end.
NEXT_PUBLIC_DELIVERY_LIVE=false

# ── Business identity and support (never invented — leave blank until confirmed) ──
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_JURISDICTION=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_RESPONSE_TIME=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_UPDATES_POLICY=
# Set to "true" once a qualified Indian legal professional has reviewed the policy pages (hides the draft notice).
NEXT_PUBLIC_LEGAL_REVIEWED=false

# The resource hub is currently public. Keep "false" until delivery is gated.
NEXT_PUBLIC_SHOW_RESOURCE_HUB=false

# ════════════════════════════════════════════════════════════════════
# On-site Razorpay checkout (server-only: NEVER prefix any of these with NEXT_PUBLIC_)
# Set real values only in .env.local (git-ignored) or in Vercel → Settings → Environment Variables.
# ════════════════════════════════════════════════════════════════════
# Razorpay API keys. Use TEST keys (rzp_test_…) while the merchant account is under review.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret. Events: order.paid, payment.failed (optional: payment.captured, payment.authorized, refund.processed).
# Webhook URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Checkout switch. Off unless exactly "true". Changing it needs a redeploy/restart but no rebuild.
CHECKOUT_ENABLED=false
# Test Mode only lets these emails check out (comma-separated; "@domain" allows a whole test domain).
# Leave a real customer's email out of this list while the account is under review.
CHECKOUT_TEST_EMAILS=
# Live keys (rzp_live_…) are refused unless this is "true". Do not set it before the merchant account is activated
# and the hosting plan allows commercial use.
CHECKOUT_LIVE_APPROVED=false

# Where orders, files and emails go. Local defaults need no accounts: memory | local | outbox.
# Production: COMMERCE_STORE=supabase, COMMERCE_STORAGE=supabase, COMMERCE_EMAIL=resend.
COMMERCE_STORE=memory
COMMERCE_STORAGE=local
COMMERCE_EMAIL=outbox

# Supabase (free tier is enough): Project Settings → API. The service-role key is a secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket and object path of the ebook (upload with scripts/upload-ebook.mjs).
SUPABASE_BUCKET=ebooks
EBOOK_STORAGE_PATH=ZERO_TO_FIRST_CLIENT_FINAL_PRODUCTION.pdf

# Resend (free tier is enough). EMAIL_FROM must use a domain you have verified in Resend
# (Resend → Domains: add the SPF/DKIM DNS records it shows). Example format only:
#   EMAIL_FROM=CRAFT & CODE <orders@your-verified-domain>
RESEND_API_KEY=
EMAIL_FROM=
# Shown in emails and on the PDF receipt, and used as Reply-To. Falls back to NEXT_PUBLIC_SUPPORT_EMAIL.
SUPPORT_EMAIL=
# Verified purchase notifications sent to the owner/admin whenever a payment is confirmed.
OWNER_EMAIL=
# The secure link is the primary delivery. Set to "true" to ALSO attach the ebook PDF (4.29 MB; Resend allows 40 MB).
EMAIL_ATTACH_EBOOK=false

# Public origin used in emailed links (defaults to NEXT_PUBLIC_SITE_URL, then https://craftandcode.tech).
APP_ORIGIN=

# Protected order view at /admin/orders (HTTP Basic auth). Disabled until both are set; password must be 9–10 characters.
ADMIN_USER=
ADMIN_PASSWORD=

# Local development only (ignored on Vercel): the private file served by the local storage driver,
# and the key that signs its 15-minute URLs. Defaults: reference/<EBOOK_STORAGE_PATH>, the webhook secret.
LOCAL_EBOOK_FILE=
LOCAL_STORAGE_SECRET=
