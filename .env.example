# ── Site ───────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, OG images and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Contact link shown in the footer (page URL or mailto:)
NEXT_PUBLIC_CONTACT_URL=https://deadcode.space/

# ── Pricing (leave blank until decided — the page shows "coming soon") ──
NEXT_PUBLIC_PRICE_INR=
# Only set if a genuine, time-bound discount exists:
NEXT_PUBLIC_COMPARE_AT_INR=
NEXT_PUBLIC_PRICE_NOTE_INR=
NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_COMPARE_AT_USD=
NEXT_PUBLIC_PRICE_NOTE_USD=

# ── Hosted checkout links (Razorpay Payment Page, Lemon Squeezy, Gumroad...) ──
# A buy button goes live only when BOTH a price and a checkout URL are set.
NEXT_PUBLIC_CHECKOUT_URL_INR=
NEXT_PUBLIC_CHECKOUT_URL_USD=

# ── Policies (plain text; leave blank to show "not published yet") ──
NEXT_PUBLIC_REFUND_POLICY=
NEXT_PUBLIC_UPDATES_POLICY=
NEXT_PUBLIC_DELIVERY_NOTE=

# The resource hub is currently public. Keep "false" until delivery is gated.
NEXT_PUBLIC_SHOW_RESOURCE_HUB=false

# ── Server-only secrets (never prefix with NEXT_PUBLIC_) ──
RAZORPAY_WEBHOOK_SECRET=
